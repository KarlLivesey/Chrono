  public static String getPattern(String locale, String kind, String style) {
    Integer kindIndex = new List<String>{
        'date',
        'time',
        'datetime',
        'yearMonth',
        'monthDay'
      }
      .indexOf(kind);
    Integer styleIndex = new List<String>{ 'short', 'medium', 'long', 'full' }
      .indexOf(style);
    if (kindIndex < 0 || styleIndex < 0) {
      throw new ChronoException(
        'Choose a supported format kind and short, medium, long or full style.'
      );
    }
    if (!patterns.containsKey(locale)) {
      return null;
    }
    return patterns.get(locale)[kindIndex * 4 + styleIndex];
  }

<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle
  xmlns="http://soap.sforce.com/2006/04/metadata"
><apiVersion>67.0</apiVersion><isExposed>true</isExposed><masterLabel
  >Chrono: Record date and time</masterLabel><description
  >Edit a native Date or DateTime field with timezone and operating-hours validation.</description><targets
  ><target>lightning__RecordPage</target></targets><targetConfigs><targetConfig
      targets="lightning__RecordPage"
    ><property
        name="dateTimeField"
        type="String"
        label="Date or DateTime field API name"
        required="true"
      /><property
        name="timeZoneField"
        type="String"
        label="Timezone text field API name (optional)"
      /><property
        name="operatingHoursField"
        type="String"
        label="OperatingHours lookup field API name (optional)"
      /><property
        name="fixedTimeZone"
        type="String"
        label="Default timezone ID"
      /><property
        name="fixedOperatingHoursId"
        type="String"
        label="Fixed OperatingHours ID"
      /><property name="label" type="String" label="Label" /><property
        name="allowTimeZoneSelection"
        type="Boolean"
        label="Allow timezone changes"
        default="false"
      /><property
        name="dateStyle"
        type="String"
        label="Date display length (user locale)"
        default="short"
        datasource="short,medium,long"
      /><supportedFormFactors><supportedFormFactor
          type="Large"
        /><supportedFormFactor
          type="Small"
        /></supportedFormFactors></targetConfig></targetConfigs></LightningComponentBundle>

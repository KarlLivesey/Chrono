  <screens>
    <name>Choose</name>
    <label>Chrono example 7 - Plan the next working time</label>
    <locationX>176</locationX>
    <locationY>134</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Inspect</targetReference>
    </connector>
    <fields>
      <name>Instructions</name>
      <fieldText
      >&lt;h2&gt;Plan the next working time&lt;/h2&gt;&lt;p&gt;Start with Sunday 30 August 2026 at 16:37 London time. This picker permits closed times so the actions can inspect and adjust them.&lt;/p&gt;&lt;p&gt;Next inspects the local time, rounds up to 16:45, checks London OperatingHours, finds Tuesday 1 September at 09:00 (Monday is a holiday), finds that day’s end, compares the two and calculates the calendar wait.&lt;/p&gt;&lt;p&gt;Expect a wait of 1 calendar day plus 16 hours 15 minutes. The calendar days and time remainder are separate outputs. Try another time or display timezone; the saved schedule always uses London.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Picker</name>
      <extensionName>skel:chronoFlowDateTime</extensionName>
      <fieldType>ComponentInstance</fieldType>
      <inputParameters>
        <name>mode</name>
        <value>
          <stringValue>datetime</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>label</name>
        <value>
          <stringValue>Choose a local date and time</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>required</name>
        <value>
          <booleanValue>true</booleanValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>dateTimeValue</name>
        <value>
          <elementReference>InitialValue</elementReference>
        </value>
      </inputParameters>
      <inputParameters>
        <name>timeZoneId</name>
        <value>
          <stringValue>Europe/London</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>operatingHoursMode</name>
        <value>
          <stringValue>none</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>allowTimeZoneSelection</name>
        <value>
          <booleanValue>true</booleanValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>allowOffsetOverride</name>
        <value>
          <booleanValue>false</booleanValue>
        </value>
      </inputParameters>
      <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
      <isRequired>true</isRequired>
      <storeOutputAutomatically>true</storeOutputAutomatically>
    </fields>
  </screens>
  <screens>
    <name>Results</name>

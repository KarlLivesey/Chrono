    <fields>
      <name>ResultText</name>
      <fieldText
      >&lt;h2&gt;Planning results&lt;/h2&gt;&lt;p&gt;Local time status: {!Inspect.resolutionStatus}&lt;/p&gt;&lt;p&gt;Rounded: {!Rounded.value}&lt;/p&gt;&lt;p&gt;Inside London operating hours: {!OpenNow.isOpen}&lt;/p&gt;&lt;p&gt;Next open time: {!NextOpen.value}&lt;/p&gt;&lt;p&gt;End of that day: {!DayEnd.value}&lt;/p&gt;&lt;p&gt;Comparison: {!Order.comparison} (-1 means before)&lt;/p&gt;&lt;p&gt;Calendar wait: {!Calendar.days} days&lt;/p&gt;&lt;p&gt;Remaining time: {!Calendar.milliseconds} milliseconds&lt;/p&gt;&lt;p&gt;ISO duration: {!Calendar.value}&lt;/p&gt;&lt;p&gt;Default remainder: 58,500,000 ms = 16 hours 15 minutes. Ignore the remainder field when only whole days matter. Use Previous to change the source.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>

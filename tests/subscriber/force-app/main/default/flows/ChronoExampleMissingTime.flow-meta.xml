<?xml version='1.0' encoding='UTF-8' ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Calculate</name>
    <label>Convert corrected instant to UTC</label>
    <locationX>176</locationX>
    <locationY>350</locationY>
    <actionName>skel__ChronoConvertAction</actionName>
    <actionType>apex</actionType>
    <connector>
      <targetReference>CheckResult</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Fault</targetReference>
    </faultConnector>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <inputParameters>
      <name>valueType</name>
      <value>
        <stringValue>Instant</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>instantValue</name>
      <value>
        <elementReference>Picker.dateTimeValue</elementReference>
      </value>
    </inputParameters>
    <inputParameters>
      <name>targetType</name>
      <value>
        <stringValue>ZonedDateTime</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>timeZoneId</name>
      <value>
        <stringValue>UTC</stringValue>
      </value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <apiVersion>67.0</apiVersion>
  <decisions>
    <name>CheckResult</name>
    <label>Did the Chrono action succeed?</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <defaultConnector>
      <targetReference>Fault</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>No</defaultConnectorLabel>
    <rules>
      <name>CheckResultYes</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Calculate.success</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Results</targetReference>
      </connector>
      <label>Yes</label>
    </rules>
  </decisions>
  <description
  >&lt;h2&gt;A time that does not exist&lt;/h2&gt;&lt;p&gt;Enter &lt;b&gt;01:30 on 29 March 2026&lt;/b&gt; in London. The clocks jump from 01:00 to 02:00, so this time never occurs.&lt;/p&gt;&lt;p&gt;Choose the nearest valid boundary: &lt;b&gt;00:59:59.999&lt;/b&gt; backwards or &lt;b&gt;02:00:00.000&lt;/b&gt; forwards. Next runs the Chrono Convert action to display the corrected instant in UTC.&lt;/p&gt;</description>
  <formulas>
    <name>InitialValue</name>
    <dataType>String</dataType>
    <expression>"2026-03-29T01:30:00.000"</expression>
  </formulas>
  <interviewLabel
  >Chrono example 3 - Missing local time {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Chrono example 3 - Missing local time</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>CanvasMode</name>
    <value>
      <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
    </value>
  </processMetadataValues>
  <processType>Flow</processType>
  <screens>
    <name>Choose</name>
    <label>Chrono example 3 - Missing local time</label>
    <locationX>176</locationX>
    <locationY>134</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Calculate</targetReference>
    </connector>
    <fields>
      <name>Instructions</name>
      <fieldText
      >&lt;h2&gt;A time that does not exist&lt;/h2&gt;&lt;p&gt;Enter &lt;b&gt;01:30 on 29 March 2026&lt;/b&gt; in London. The clocks jump from 01:00 to 02:00, so this time never occurs.&lt;/p&gt;&lt;p&gt;Choose the nearest valid boundary: &lt;b&gt;00:59:59.999&lt;/b&gt; backwards or &lt;b&gt;02:00:00.000&lt;/b&gt; forwards. Next runs the Chrono Convert action to display the corrected instant in UTC.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Picker</name>
      <extensionName>skel:chronoFlowDateTime</extensionName>
      <fieldType>ComponentInstance</fieldType>
      <inputParameters>
        <name>mode</name>
        <value>
          <stringValue>datetime</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>label</name>
        <value>
          <stringValue>Choose a local date and time</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>required</name>
        <value>
          <booleanValue>true</booleanValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>initialChronoValue</name>
        <value>
          <elementReference>InitialValue</elementReference>
        </value>
      </inputParameters>
      <inputParameters>
        <name>timeZoneId</name>
        <value>
          <stringValue>Europe/London</stringValue>
        </value>
      </inputParameters>
      <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
      <isRequired>true</isRequired>
      <storeOutputAutomatically>true</storeOutputAutomatically>
    </fields>
  </screens>
  <screens>
    <name>Results</name>
    <label>Chrono action result</label>
    <locationX>176</locationX>
    <locationY>458</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>ResultText</name>
      <fieldText
      >&lt;h2&gt;The corrected instant&lt;/h2&gt;&lt;p&gt;&lt;b&gt;UTC (ISO):&lt;/b&gt; {!Calculate.value}&lt;/p&gt;&lt;p&gt;Backwards gives 00:59:59.999 UTC; forwards gives 01:00:00.000 UTC, which is 02:00 in London.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Action succeeded:&lt;/b&gt; {!Calculate.success}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Error (if any):&lt;/b&gt; {!Calculate.errorMessage}&lt;/p&gt;&lt;p&gt;Use Previous to try another value. Finish closes this example.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>TransportValues</name>
      <fieldText
      >&lt;h3&gt;Values available to the rest of the Flow&lt;/h3&gt;&lt;p&gt;Local date: {!Picker.chronoDateValue}&lt;/p&gt;&lt;p&gt;Local date/time: {!Picker.chronoPlainDateTimeValue}&lt;/p&gt;&lt;p&gt;Zoned date/time: {!Picker.chronoZonedDateTimeValue}&lt;/p&gt;&lt;p&gt;Instant: {!Picker.chronoInstantValue}&lt;/p&gt;&lt;p&gt;Native Datetime: {!Picker.dateTimeValue}&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <screens>
    <name>Fault</name>
    <label>The example could not run</label>
    <locationX>176</locationX>
    <locationY>458</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>FaultText</name>
      <fieldText
      >&lt;h2&gt;Review the inputs&lt;/h2&gt;&lt;p&gt;{!Calculate.errorMessage}&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Go back to correct the value, timezone or schedule. The action reports invalid input instead of returning a misleading date.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Choose</targetReference>
    </connector>
  </start>
  <status>Active</status>
</Flow>

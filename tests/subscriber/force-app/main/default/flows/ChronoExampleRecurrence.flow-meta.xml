  <screens>
    <name>Choose</name>
    <label>Choose the first Sunday meeting</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Occurrences</targetReference>
    </connector>
    <fields>
      <name>ChooseText</name>
      <fieldText
      >&lt;h2&gt;Six Sunday meetings across the clock change&lt;/h2&gt;&lt;p&gt;Start on Sunday 22 March 2026 at 01:30 London time. The weekly rule skips 29 March because that clock time does not exist. The sixth meeting is 3 May at 01:30 BST.&lt;/p&gt;&lt;p&gt;Choose another Sunday to try a different series. Next generates six occurrences, summarises the collection and formats the first and last using your Salesforce locale.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Picker</name>
      <extensionName>skel:chronoFlowDateTime</extensionName>
      <fieldType>ComponentInstance</fieldType>
      <inputParameters>
        <name>mode</name>
        <value>
          <stringValue>datetime</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>label</name>
        <value>
          <stringValue>First Sunday meeting</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>initialChronoValue</name>
        <value>
          <stringValue
          >2026-03-22T01:30:00.000+00:00[Europe/London]</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>timeZoneId</name>
        <value>
          <stringValue>Europe/London</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>operatingHoursMode</name>
        <value>
          <stringValue>none</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>dateStyle</name>
        <value>
          <stringValue>short</stringValue>
        </value>
      </inputParameters>
      <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
      <isRequired>true</isRequired>
      <storeOutputAutomatically>true</storeOutputAutomatically>
    </fields>
  </screens>
  <screens>
    <name>Results</name>
    <label>Recurring meeting results</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>ResultsText</name>
      <fieldText
      >&lt;h2&gt;Meeting series&lt;/h2&gt;&lt;p&gt;Occurrences: {!Summary.count}&lt;/p&gt;&lt;p&gt;First: {!FirstMeeting.text}&lt;/p&gt;&lt;p&gt;Last: {!LastMeeting.text}&lt;/p&gt;&lt;p&gt;First ISO value: {!Summary.earliestValue}&lt;/p&gt;&lt;p&gt;Last ISO value: {!Summary.latestValue}&lt;/p&gt;&lt;p&gt;Valid ordered interval: {!Coverage.isValid}&lt;/p&gt;&lt;p&gt;The recurrence output is a Text collection of zoned ISO values. Flow can loop over it to create records; this example performs no DML. Use Previous to choose another starting Sunday.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>

<?xml version='1.0' encoding='UTF-8' ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Calculate</name>
    <label>Convert the request collection</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <actionName>skel__ChronoConvertCollectionAction</actionName>
    <actionType>apex</actionType>
    <connector>
      <targetReference>EachResult</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Fault</targetReference>
    </faultConnector>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <inputParameters>
      <name>items</name>
      <value>
        <elementReference>Requests</elementReference>
      </value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <apiVersion>67.0</apiVersion>
  <assignments>
    <name>Prepare</name>
    <label>Build three request values</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <assignmentItems>
      <assignToReference>Requests</assignToReference>
      <operator>RemoveAll</operator>
      <value>
        <elementReference>Requests</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>OutputText</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>Results:</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>First.valueType</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>PlainDate</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>First.value</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>2026-09-07</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>First.targetType</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>PlainYearMonth</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Second.valueType</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>Instant</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Second.value</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>2026-10-25T00:30Z</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Second.targetType</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>ZonedDateTime</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Second.timeZoneId</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>Europe/London</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Invalid.valueType</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>PlainDate</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Invalid.value</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>2026-02-30</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Requests</assignToReference>
      <operator>Add</operator>
      <value>
        <elementReference>First</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Requests</assignToReference>
      <operator>Add</operator>
      <value>
        <elementReference>Second</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Requests</assignToReference>
      <operator>Add</operator>
      <value>
        <elementReference>Invalid</elementReference>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Calculate</targetReference>
    </connector>
  </assignments>
  <assignments>
    <name>AppendResult</name>
    <label>Append the result or item error</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <assignmentItems>
      <assignToReference>OutputText</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>NextLine</elementReference>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>EachResult</targetReference>
    </connector>
  </assignments>
  <description
  >Build an explicit collection of three conversion requests and display ordered results, including an intentionally invalid item.</description>
  <formulas>
    <name>NextLine</name>
    <dataType>String</dataType>
    <expression
    >{!OutputText} &amp; BR() &amp; IF({!EachResult.success}, {!EachResult.value}, "Error: " &amp; {!EachResult.errorMessage})</expression>
  </formulas>
  <interviewLabel>Chrono collections {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Chrono example 6 - Collection conversions</label>
  <loops>
    <name>EachResult</name>
    <label>Read each ordered result</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <collectionReference>Calculate.results</collectionReference>
    <iterationOrder>Asc</iterationOrder>
    <nextValueConnector>
      <targetReference>AppendResult</targetReference>
    </nextValueConnector>
    <noMoreValuesConnector>
      <targetReference>Results</targetReference>
    </noMoreValuesConnector>
  </loops>
  <processType>Flow</processType>
  <screens>
    <name>Choose</name>
    <label>Try a collection action</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Prepare</targetReference>
    </connector>
    <fields>
      <name>ChooseText</name>
      <fieldText
      >&lt;h2&gt;Three requests in one action&lt;/h2&gt;&lt;p&gt;This Flow constructs a request collection using Assignment elements:&lt;/p&gt;&lt;p&gt;1. Date 7 September 2026 → year/month (&lt;b&gt;2026-09&lt;/b&gt;).&lt;/p&gt;&lt;p&gt;2. Instant 25 October 2026 00:30 UTC → London zoned date/time (&lt;b&gt;01:30 BST&lt;/b&gt;).&lt;/p&gt;&lt;p&gt;3. Invalid date → an item error. The other results still succeed.&lt;/p&gt;&lt;p&gt;Next runs the collection action and loops over its results in order. Open the action in Builder to see the typed collection resource selector.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <screens>
    <name>Results</name>
    <label>Ordered collection results</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>ResultsText</name>
      <fieldText
      >&lt;h2&gt;Collection results&lt;/h2&gt;&lt;p&gt;{!OutputText}&lt;/p&gt;&lt;p&gt;The invalid third item does not discard the first two results. Each result has its own success flag and error message.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <screens>
    <name>Fault</name>
    <label>The collection could not run</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>FaultText</name>
      <fieldText>&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <start>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Choose</targetReference>
    </connector>
  </start>
  <status>Active</status>
  <variables>
    <name>First</name>
    <apexClass>skel__ChronoConvertInput</apexClass>
    <dataType>Apex</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
  <variables>
    <name>Second</name>
    <apexClass>skel__ChronoConvertInput</apexClass>
    <dataType>Apex</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
  <variables>
    <name>Invalid</name>
    <apexClass>skel__ChronoConvertInput</apexClass>
    <dataType>Apex</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
  <variables>
    <name>Requests</name>
    <apexClass>skel__ChronoConvertInput</apexClass>
    <dataType>Apex</dataType>
    <isCollection>true</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
  <variables>
    <name>OutputText</name>
    <dataType>String</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
</Flow>

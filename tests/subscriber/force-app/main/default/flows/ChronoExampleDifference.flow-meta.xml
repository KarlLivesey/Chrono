  <description
  >Compare elapsed and OperatingHours duration between two zoned inputs. The default spans a weekend and Monday bank holiday.</description>
  <formulas>
    <name>StartValue</name>
    <dataType>DateTime</dataType>
    <expression>DATETIMEVALUE("2026-08-28 15:30:00")</expression>
  </formulas>
  <formulas>
    <name>EndValue</name>
    <dataType>DateTime</dataType>
    <expression>DATETIMEVALUE("2026-09-01 08:30:00")</expression>
  </formulas>
  <formulas>
    <name>ElapsedHours</name>
    <dataType>Number</dataType>
    <expression>{!Elapsed.milliseconds} / 3600000</expression>
    <scale>3</scale>
  </formulas>
  <formulas>
    <name>WorkingHours</name>
    <dataType>Number</dataType>
    <expression>{!Working.milliseconds} / 3600000</expression>
    <scale>3</scale>
  </formulas>

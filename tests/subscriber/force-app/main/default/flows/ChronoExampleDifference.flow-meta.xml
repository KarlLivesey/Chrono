    <rules>
      <name>CheckScheduleYes</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>DemoHours.Id</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>

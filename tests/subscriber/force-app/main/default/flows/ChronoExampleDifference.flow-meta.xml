  <decisions>
    <name>CheckElapsed</name>
    <label>Did elapsed difference succeed?</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <defaultConnector>
      <targetReference>Fault</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>No</defaultConnectorLabel>
    <rules>
      <name>CheckElapsedYes</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Elapsed.success</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>CheckWorking</targetReference>
      </connector>
      <label>Yes</label>
    </rules>
  </decisions>

    <defaultConnector>
      <targetReference>Fault</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>No</defaultConnectorLabel>
    <rules>
      <name>CheckResultYes</name>
      <conditionLogic>and</conditionLogic>

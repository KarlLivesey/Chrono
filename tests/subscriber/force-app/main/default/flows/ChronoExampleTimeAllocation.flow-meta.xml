<?xml version='1.0' encoding='UTF-8' ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <name>Allocate</name>
    <label>Allocate time to blocks</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <actionName>skel__ChronoTimeAllocationAction</actionName>
    <actionType>apex</actionType>
    <connector>
      <targetReference>CheckAllocation</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Fault</targetReference>
    </faultConnector>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <inputParameters>
      <name>valueType</name>
      <value>
        <stringValue>ZonedDateTime</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>value</name>
      <value>
        <elementReference>Range.startValue</elementReference>
      </value>
    </inputParameters>
    <inputParameters>
      <name>endValue</name>
      <value>
        <elementReference>Range.endValue</elementReference>
      </value>
    </inputParameters>
    <inputParameters>
      <name>timeZoneId</name>
      <value>
        <stringValue>Europe/London</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>blocksText</name>
      <value>
        <stringValue
        >[{"key":"one","label":"Block 1 (08\u201310)","startTime":"08:00","endTime":"10:00","weekdays":"1,2,3,4,5"},{"key":"two","label":"Block 2 (10\u201311)","startTime":"10:00","endTime":"11:00","weekdays":"1,2,3,4,5"},{"key":"three","label":"Block 3 (11\u201315)","startTime":"11:00","endTime":"15:00","weekdays":"1,2,3,4,5"},{"key":"holiday","label":"Bank holiday (08\u201312)","dayType":"holiday","startTime":"08:00","endTime":"12:00"}]</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>holidays</name>
      <value>
        <elementReference>Holidays</elementReference>
      </value>
    </inputParameters>
    <inputParameters>
      <name>overlapMode</name>
      <value>
        <stringValue>strict</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>timeBasis</name>
      <value>
        <stringValue>elapsed</stringValue>
      </value>
    </inputParameters>
    <inputParameters>
      <name>allocationUnit</name>
      <value>
        <stringValue>millisecond</stringValue>
      </value>
    </inputParameters>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </actionCalls>
  <apiVersion>67.0</apiVersion>
  <assignments>
    <name>Prepare</name>
    <label>Prepare demonstration holiday and clear totals</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <assignmentItems>
      <assignToReference>Holidays</assignToReference>
      <operator>RemoveAll</operator>
      <value>
        <elementReference>Holidays</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Holiday.Name</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>Demonstration bank holiday</stringValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Holiday.ActivityDate</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>HolidayDate</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Holiday.IsAllDay</assignToReference>
      <operator>Assign</operator>
      <value>
        <booleanValue>true</booleanValue>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Holidays</assignToReference>
      <operator>Add</operator>
      <value>
        <elementReference>Holiday</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>Summary</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>Block totals:</stringValue>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Allocate</targetReference>
    </connector>
  </assignments>
  <assignments>
    <name>AppendTotal</name>
    <label>Append block name and allocated duration</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <assignmentItems>
      <assignToReference>Summary</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>NextLine</elementReference>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>EachBlock</targetReference>
    </connector>
  </assignments>
  <decisions>
    <name>CheckAllocation</name>
    <label>Check calculate elapsed time</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <defaultConnector>
      <targetReference>Fault</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Failed</defaultConnectorLabel>
    <rules>
      <name>AllocateSucceeded</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Allocate.success</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>EachBlock</targetReference>
      </connector>
      <label>Succeeded</label>
    </rules>
  </decisions>
  <formulas>
    <name>HolidayDate</name>
    <dataType>Date</dataType>
    <expression>DATE(2026, 9, 8)</expression>
  </formulas>
  <formulas>
    <name>NextLine</name>
    <dataType>String</dataType>
    <expression
    >{!Summary} &amp; BR() &amp; {!EachBlock.label} &amp; ": " &amp; TEXT({!EachBlock.allocatedMilliseconds} / 3600000) &amp; " hours (" &amp; {!EachBlock.allocatedDuration} &amp; ")"</expression>
  </formulas>
  <interviewLabel
  >Chrono time allocation {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Chrono example 13 - Time allocation and holiday blocks</label>
  <loops>
    <name>EachBlock</name>
    <label>Read each block total</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <collectionReference>Allocate.totals</collectionReference>
    <iterationOrder>Asc</iterationOrder>
    <nextValueConnector>
      <targetReference>AppendTotal</targetReference>
    </nextValueConnector>
    <noMoreValuesConnector>
      <targetReference>Results</targetReference>
    </noMoreValuesConnector>
  </loops>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>CanvasMode</name>
    <value>
      <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
    </value>
  </processMetadataValues>
  <processType>Flow</processType>
  <screens>
    <name>Choose</name>
    <label>Choose worked time</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Prepare</targetReference>
    </connector>
    <fields>
      <name>ChooseText</name>
      <fieldText
      >&lt;p&gt;Monday 08:00–12:00 gives 2 hours in block 1, 1 in block 2 and 1 in block 3. Change both endpoints to Tuesday 8 September to see the separate four-hour bank-holiday block.&lt;/p&gt;&lt;p&gt;The holiday is an unsaved demonstration record. This flow writes no records. Edit the Allocate time to blocks action to try priority, duplication, splitting or whole-minute allocation.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
    <fields>
      <name>Range</name>
      <extensionName>skel:chronoFlowRange</extensionName>
      <fieldType>ComponentInstance</fieldType>
      <inputParameters>
        <name>mode</name>
        <value>
          <stringValue>datetime</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>label</name>
        <value>
          <stringValue>Worked interval</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>timeZoneId</name>
        <value>
          <stringValue>Europe/London</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>allowTimeZoneSelection</name>
        <value>
          <booleanValue>true</booleanValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>dateStyle</name>
        <value>
          <stringValue>short</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>required</name>
        <value>
          <booleanValue>true</booleanValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>startValue</name>
        <value>
          <stringValue
          >2026-09-07T08:00:00.000+01:00[Europe/London]</stringValue>
        </value>
      </inputParameters>
      <inputParameters>
        <name>endValue</name>
        <value>
          <stringValue
          >2026-09-07T12:00:00.000+01:00[Europe/London]</stringValue>
        </value>
      </inputParameters>
      <isRequired>true</isRequired>
      <storeOutputAutomatically>true</storeOutputAutomatically>
    </fields>
  </screens>
  <screens>
    <name>Results</name>
    <label>Allocation totals</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Totals</name>
      <fieldText
      >&lt;p&gt;{!Summary}&lt;/p&gt;&lt;p&gt;Allocated milliseconds: {!Allocate.allocatedMilliseconds}&lt;br/&gt;Unallocated: {!Allocate.unallocatedMilliseconds}&lt;br/&gt;Added by duplication: {!Allocate.duplicateMilliseconds}&lt;br/&gt;Rounding remainder: {!Allocate.roundingMilliseconds}&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <screens>
    <name>Fault</name>
    <label>Example could not continue</label>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>FaultText</name>
      <fieldText
      >&lt;p&gt;{!Allocate.errorMessage} {!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Use Previous to correct the input or configuration.&lt;/p&gt;</fieldText>
      <fieldType>DisplayText</fieldType>
    </fields>
  </screens>
  <start>
    <locationX>0</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Choose</targetReference>
    </connector>
  </start>
  <status>Active</status>
  <variables>
    <name>Holiday</name>
    <dataType>SObject</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
    <objectType>Holiday</objectType>
  </variables>
  <variables>
    <name>Holidays</name>
    <dataType>SObject</dataType>
    <isCollection>true</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
    <objectType>Holiday</objectType>
  </variables>
  <variables>
    <name>Summary</name>
    <dataType>String</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
</Flow>
